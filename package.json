{
  "name": "log-explainer-ai",
  "description": "Analyze and explain log files using AI",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest",
    "start": "node src/index.js",
    "lint": "eslint './src/**/*.js' './diagnostics/**/*.js' --fix",
    "format": "prettier --write './src/**/*.js' './diagnostics/**/*.js' ",
    "docs": "jsdoc -c jsdoc.json",
    "precommit-no-test": "npm run lint && npm run format && npm run docs",
    "precommit": "npm run lint && npm run format && npm run docs && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obsidianstorms/log-explainer-ai.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/obsidianstorms/log-explainer-ai/issues"
  },
  "homepage": "https://github.com/obsidianstorms/log-explainer-ai#readme",
  "dependencies": {
    "dotenv": "^17.4.1",
    "fetch-to-curl": "^0.6.0",
    "ollama": "^0.6.3",
    "openai": "^6.34.0"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^61.7.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-sonarjs": "^4.0.2",
    "jsdoc": "^4.0.5",
    "prettier": "^3.8.2",
    "prettier-plugin-multiline-arrays": "^4.1.8",
    "vitest": "^3.2.4"
  }
}
